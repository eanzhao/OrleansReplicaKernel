<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OrleansReplicaKernel</AssemblyName>
    <RootNamespace>OrleansReplicaKernel</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <IsPackable>true</IsPackable>
    <PackageId>OrleansReplicaKernel</PackageId>
    <Version>0.1.0</Version>
    <Authors>eanzhao</Authors>
    <Description>A replica implementation of Microsoft Orleans' virtual actor framework kernel for .NET 10.</Description>
    <PackageTags>orleans;actors;virtual-actors;distributed-systems;grains</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/eanzhao/OrleansReplicaKernel</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OrleansReplicaKernel.CodeGenerator/OrleansReplicaKernel.CodeGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
